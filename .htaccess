# ═══════════════════════════════════════════════════════════════════
# Bondor Bati POS — Apache Configuration
# ═══════════════════════════════════════════════════════════════════

Options -Indexes -MultiViews

# ── URL Rewriting ─────────────────────────────────────────────────
RewriteEngine On

# Serve real files and directories directly (css/js/images etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through the front controller
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# ── Block Sensitive Paths ─────────────────────────────────────────
RewriteRule ^(config|app/Core|_deploy|logs)/.*$ - [F,L]

# Block direct access to PHP files in subdirectories (only index.php allowed at root)
RewriteRule ^app/.*\.php$ - [F,L]

# ── Security Headers (backup for servers without PHP headers) ─────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Remove server fingerprint headers
    Header unset Server
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ── Compression (GZIP) ────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml application/xml text/xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf
</IfModule>

# ── Browser Caching ───────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images: 30 days
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpg  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif  "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType font/ttf   "access plus 1 year"

    # CSS/JS: 7 days
    ExpiresByType text/css         "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"

    # JSON manifest: 1 day
    ExpiresByType application/json "access plus 1 day"

    # HTML/PHP (dynamic pages): no cache
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Disable PHP Error Output to Browser ───────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_reporting 32767
</IfModule>

# ── Block Common Attack Patterns ─────────────────────────────────
<IfModule mod_rewrite.c>
    # Block SQL injection attempts in query strings
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule .* - [F,L]
</IfModule>
